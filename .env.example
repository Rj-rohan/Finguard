# Database
# Local: use SQLite → file:./prisma/dev.db
# Production (Railway): PostgreSQL URL auto-provided
DATABASE_URL="file:./prisma/dev.db"

# Groq API Keys (get free keys at console.groq.com)
# All 3 are used with automatic rotation on rate limit
GROQ_API_KEY_1=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="LeakZero AI"

# Optional: set this if running behind a proxy
# NEXTAUTH_URL="http://localhost:3000"
